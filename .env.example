# PetHealthPD — configuração local (copie para .env e ajuste os valores)
# O Prisma CLI lê este arquivo da raiz; o processo principal do Electron usa
# src/main/config/carregarEnv.ts para carregá-lo em runtime.

DATABASE_URL="mysql://pethealthpd_app:troque-esta-senha@localhost:3306/pethealthpd"

# Usado apenas por `npm run seed:admin` (não é lido pelo runtime do app).
PHD_ADMIN_NOME="Administrador da Clínica"
PHD_ADMIN_EMAIL="admin@clinica.local"
PHD_ADMIN_SENHA="troque-esta-senha"
